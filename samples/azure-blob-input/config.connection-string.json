{
  "source": {
    "type": "azure-blob",
    "url": "https://<account>.blob.core.windows.net/<container>/daily/products.csv",
    "auth": {
      "connectionString": "DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<account-key>;EndpointSuffix=core.windows.net"
    }
  },
  "output": {
    "filename": "item_master.csv",
    "header": "SKU;BARCODE",
    "template": "{ITEM};{BARCODE}",
    "separator": ";",
    "path": "/var/tmp"
  },
  "options": {
    "line": {
      "columns": [
        "LOC",
        "ITEM",
        "DEPT",
        "DEPT_NAME",
        "CLASS",
        "CLASS_NAME",
        "SUBCLASS",
        "SUB_NAME",
        "ITEM_DESC",
        "AV_COST",
        "SELLING_UNIT_RETAIL",
        "CURRENCY_CODE",
        "UDA_VALUE",
        "ITEM_LOC_STATUS",
        "SIZE",
        "BARCODE"
      ],
      "mandatoryFields": [],
      "identifierMappings": [],
      "outputMappings": [],
      "separator": ",",
      "withHeader": true
    },
    "rejectOnInvalidRow": false
  }
}

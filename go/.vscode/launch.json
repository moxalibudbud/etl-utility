{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debug file",
      "type": "go",
      "request": "launch",
      "mode": "auto", 
      "program": "${fileDirname}"
    },
    {
      "name": "Debug cmd/etl",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/etl",
      "args": [
        "-source", "/var/tmp/INT01_8001_21364_202605200906.csv",
        "-columns", "TYPE_ATTRIBUT,CODE_ATTRIBUT,LIBELLE_ATTRIBUT,TYPE_ATTRIBUT_PARENT,CODE_ATTRIBUT_PARENT",
        "-mandatory", "TYPE_ATTRIBUT,CODE_ATTRIBUT",
        "-separator", ";",
        "-with-header",
        "-out-path", "/var/tmp",
        "-out-filename", "out.csv",
        "-out-separator", ";",
        "-header", "code,label",
        "-footer", "EOF"
      ]
    }
  ]
}
